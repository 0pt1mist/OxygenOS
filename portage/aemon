-- OxygenOS AE2 Monitor v2.3 (Stable)
local driver = sys.include("driver")
local w, h = sys.gpu.res()

-- == MAIN FUNCTION ==
local function main()
  -- Colors
  local C_BG = 0x000000
  local C_FG = 0xFFFFFF
  local C_ACCENT = 0x00AA00
  local C_ERR = 0xFF0000
  local C_GRAPH_BAR = 0x00FFFF
  local C_GRAPH_BG = 0x222222
  local C_Box = 0xFFFFFF

  local controller = driver.find("me_controller")
  local interface = driver.find("me_interface")

  local scroll_offset = 0
  local items_list = {}
  local power_history = {}
  local GRAPH_WIDTH = 30
  for i=1, GRAPH_WIDTH do power_history[i] = 0 end

  local update_timer = 100 
  local UPDATE_THRESHOLD = 20 

  -- Helper Functions
  local function clear()
    sys.gpu.setBackground(C_BG)
    sys.gpu.setForeground(C_FG)
    sys.gpu.fill(1, 1, w, h, " ")
  end

  local function drawBox(x, y, bw, bh, title)
    sys.gpu.setBackground(C_BG)
    sys.gpu.setForeground(C_Box)
    sys.gpu.fill(x, y, bw, 1, "-")
    sys.gpu.fill(x, y+bh-1, bw, 1, "-")
    sys.gpu.fill(x, y, 1, bh, "|")
    sys.gpu.fill(x+bw-1, y, 1, bh, "|")
    sys.gpu.set(x+2, y, " " .. title .. " ")
  end

  local function formatNum(n)
    if type(n) ~= "number" then return "0" end
    if n >= 1000000000 then return string.format("%.1fB", n/1000000000) end
    if n >= 1000000 then return string.format("%.1fM", n/1000000) end
    if n >= 1000 then return string.format("%.1fk", n/1000) end
    return tostring(math.floor(n))
  end
  
  local function formatUsage(n)
    if type(n) ~= "number" then return "0.00" end
    return string.format("%.2f", n)
  end

  local function drawGraph(x, y, gw, gh, data, maxVal)
    sys.gpu.setBackground(C_GRAPH_BG)
    sys.gpu.fill(x, y, gw, gh, " ")
    if maxVal <= 0 then maxVal = 1 end
    for i = 1, gw do
      local val = data[#data - (gw - i)] or 0
      local barH = math.floor((val / maxVal) * gh)
      if barH > gh then barH = gh end
      if barH > 0 then
        sys.gpu.setBackground(C_GRAPH_BG)
        sys.gpu.setForeground(C_GRAPH_BAR)
        sys.gpu.fill(x + i - 1, y + gh - barH, 1, barH, "|")
      end
    end
    sys.gpu.setBackground(C_BG)
    sys.gpu.setForeground(C_FG)
  end

  -- Start UI
  clear()
  local pStored, pMax, pUsage = 0, 0, 0
  local status_msg = "Init"

  while true do
    -- 1. UPDATE DATA
    update_timer = update_timer + 1
    
    if update_timer > UPDATE_THRESHOLD then
      collectgarbage() -- Обязательная чистка памяти
      
      status_msg = "Upd..."
      
      if controller then
         local ok, res = pcall(controller.getStoredPower)
         pStored = ok and res or -1
         
         ok, res = pcall(controller.getMaxStoredPower)
         pMax = ok and res or -1
         
         ok, res = pcall(controller.getAvgPowerUsage)
         pUsage = ok and res or 0
         
         table.insert(power_history, pUsage)
         if #power_history > GRAPH_WIDTH then table.remove(power_history, 1) end
      end
      
      if interface then
         local ok, list = pcall(interface.getItemsInNetwork)
         if ok and list then
            -- Сортировка (может упасть при нехватке памяти)
            pcall(table.sort, list, function(a,b) return a.size > b.size end)
            items_list = list
         else
            status_msg = "Link Err"
         end
      end
      update_timer = 0
    else
      status_msg = "Idle"
    end

    -- 2. DRAW UI
    sys.gpu.setBackground(C_BG)
    sys.gpu.setForeground(C_FG)
    
    -- Header
    sys.gpu.fill(1, 1, w, 1, " ")
    sys.gpu.set(1, 1, " OxygenOS Monitor v2.3")
    sys.gpu.set(w-20, 1, "[Q] Exit | " .. status_msg)
    
    -- Stats
    drawBox(2, 3, 35, 8, "Power")
    sys.gpu.setBackground(C_BG)
    sys.gpu.setForeground(C_FG)
    
    if controller then
       if pStored == -1 then
          sys.gpu.setForeground(C_ERR)
          sys.gpu.set(4, 5, "NO DATA")
       else
          sys.gpu.set(4, 5, "Usage:  " .. formatUsage(pUsage) .. " AE/t")
          sys.gpu.set(4, 6, "Stored: " .. formatNum(pStored))
          
          local pct = 0
          if pMax > 0 then pct = math.floor((pStored/pMax)*100) end
          sys.gpu.set(4, 8, "Battery: " .. pct .. "%")
       end
    else
       sys.gpu.setForeground(C_ERR)
       sys.gpu.set(4, 6, "NO CONTROLLER")
    end
    
    -- Graph
    local graph_x = 39
    local graph_w = w - graph_x - 1
    if graph_w ~= GRAPH_WIDTH then GRAPH_WIDTH = graph_w end
    
    drawBox(graph_x, 3, graph_w+2, 8, "Graph")
    if controller then
       local gMax = 100
       for _,v in pairs(power_history) do if v > gMax then gMax = v end end
       drawGraph(graph_x+1, 4, graph_w, 6, power_history, gMax)
    end

    -- List
    local list_y = 12
    local list_h = h - list_y - 1
    drawBox(2, list_y, w-2, list_h+2, "Items (" .. #items_list .. ")")
    
    local view_size = list_h - 3
    if view_size < 1 then view_size = 1 end
    
    for i = 1, view_size do
      local idx = scroll_offset + i
      local item = items_list[idx]
      local yPos = list_y + 2 + i
      sys.gpu.setBackground(C_BG)
      sys.gpu.setForeground(C_FG)
      sys.gpu.fill(3, yPos, w-4, 1, " ")
      
      if item then
         local label = item.label or "??"
         sys.gpu.set(4, yPos, string.sub(label, 1, 20))
         sys.gpu.set(w-10, yPos, formatNum(item.size))
      end
    end
    
    -- Scrollbar
    if #items_list > view_size then
      local bar_h = math.floor((view_size / #items_list) * view_size)
      if bar_h < 1 then bar_h = 1 end
      local bar_y = math.floor((scroll_offset / #items_list) * view_size)
      sys.gpu.setBackground(C_BG)
      sys.gpu.setForeground(C_ACCENT)
      sys.gpu.fill(w-1, list_y + 3 + bar_y, 1, bar_h, "|")
    end

    -- 3. INPUT
    local sig = {sys.pull(0.1)}
    if sig[1] == "key_down" then
      local code = sig[4]
      if code == 16 or code == 46 then break end -- Q or C
      if code == 200 and scroll_offset > 0 then scroll_offset = scroll_offset - 1 end
      if code == 208 and scroll_offset < (#items_list - view_size) then scroll_offset = scroll_offset + 1 end
      if code == 201 then scroll_offset = 0 end -- Home/PgUp logic simplified
      if code == 209 then scroll_offset = #items_list - view_size end -- End/PgDn
    elseif sig[1] == "scroll" then
      if sig[5] > 0 then
         if scroll_offset > 0 then scroll_offset = scroll_offset - 1 end
      else
         if scroll_offset < (#items_list - view_size) then scroll_offset = scroll_offset + 1 end
      end
    end
    
  end
  
  sys.gpu.setBackground(0x000000)
  sys.gpu.setForeground(0xFFFFFF)
  sys.gpu.fill(1, 1, w, h, " ")
  print("Exited.")
end

-- == EXECUTE SAFELY ==
-- Запускаем без debug.traceback, так как его нет в песочнице
local status, err = xpcall(main, function(e) return tostring(e) end)

if not status then
  sys.gpu.setBackground(0x000000)
  sys.gpu.setForeground(0xFF0000)
  print("\nCRASH REPORT:")
  print(err)
end